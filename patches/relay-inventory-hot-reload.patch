--- a/tests/test_inventory.py
+++ b/tests/test_inventory.py
@@ -1,7 +1,9 @@
 from __future__ import annotations
 
 import json
+import os
 from pathlib import Path
+from unittest.mock import patch
 
 from relay_shell.inventory import Inventory
 
@@ -83,3 +85,59 @@ def test_non_ascii_digit_port_is_ignored_not_a_crash(tmp_path: Path) -> None:
     cfg.write_text("Host odd\n    HostName 10.0.0.9\n    Port ²\n", encoding="utf-8")
     hosts = {h.name: h for h in Inventory(str(cfg), "").load().hosts()}
     assert hosts["odd"].port is None
+
+
+def test_inventory_register_update_remove_without_restart(tmp_path: Path) -> None:
+    invf = tmp_path / "inv.json"
+    inv = Inventory(str(tmp_path / "config"), str(invf)).load()
+    assert inv.hosts() == []
+
+    invf.write_text(json.dumps({"train": {"hostname": "127.0.0.1", "port": 23001}}))
+    assert inv.knows("train")
+    assert inv.resolve("train").port == 23001
+    assert [h.name for h in inv.hosts()] == ["train"]
+
+    # Registry writers replace JSON atomically. Even preserving size and mtime,
+    # replacing its inode must invalidate the cached endpoint.
+    stamp = invf.stat()
+    replacement = tmp_path / "next.json"
+    replacement.write_text(json.dumps({"train": {"hostname": "127.0.0.1", "port": 23002}}))
+    os.utime(replacement, ns=(stamp.st_atime_ns, stamp.st_mtime_ns))
+    replacement.replace(invf)
+    assert inv.resolve("train").port == 23002
+
+    invf.unlink()
+    assert not inv.knows("train")
+    assert inv.hosts() == []
+
+
+def test_ssh_config_refresh_preserves_inventory_override(tmp_path: Path) -> None:
+    cfg = tmp_path / "config"
+    cfg.write_text("Host train\n  HostName 10.0.0.1\n")
+    invf = tmp_path / "inv.json"
+    invf.write_text(json.dumps({"train": {"hostname": "127.0.0.1", "port": 23001}}))
+    inv = Inventory(str(cfg), str(invf)).load()
+    cfg.write_text("Host train\n  HostName 10.0.0.2\nHost extra\n  HostName 10.0.0.3\n")
+    assert inv.ssh_config_aliases() == ["extra", "train"]
+    assert inv.resolve("train").hostname == "127.0.0.1"
+    assert inv.resolve("extra").hostname == "10.0.0.3"
+
+
+def test_unchanged_inventory_does_not_read_contents(tmp_path: Path) -> None:
+    invf = tmp_path / "inv.json"
+    invf.write_text(json.dumps({"train": {"hostname": "127.0.0.1"}}))
+    inv = Inventory(str(tmp_path / "config"), str(invf)).load()
+    with patch.object(Path, "read_text", side_effect=AssertionError("unexpected re-read")):
+        assert inv.resolve("train").hostname == "127.0.0.1"
+        assert inv.knows("train")
+        assert len(inv.hosts()) == 1
+        assert inv.ssh_config_aliases() == []
+
+
+def test_invalid_inventory_then_repaired_refreshes(tmp_path: Path) -> None:
+    invf = tmp_path / "inv.json"
+    invf.write_text("invalid")
+    inv = Inventory(str(tmp_path / "config"), str(invf)).load()
+    assert inv.hosts() == []
+    invf.write_text(json.dumps({"train": {"hostname": "127.0.0.1"}}))
+    assert inv.knows("train")
